{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.adelebake.com"
        }
      ],
      "destination": "https://adelebake.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.adelebake.com"
        }
      ],
      "destination": "https://adelebake.com/:path+",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": {
      "maquettes": false
    }
  }
}
