# --- Base de données (docker compose up -d → PostgreSQL local sur 5433) ---
DATABASE_URL="postgresql://adelebake:adelebake_dev@127.0.0.1:5433/adelebake?schema=public"

# --- URL publique du site (liens dans les e-mails, sitemap, SEO) ---
SITE_URL="http://localhost:3000"

# --- Sessions du back-office : chaîne aléatoire d'au moins 32 caractères ---
# openssl rand -base64 48
AUTH_SECRET=""

# --- Premier compte administrateur (utilisé par npm run db:seed / admin:create) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- E-mails sortants (SMTP du domaine, avec SPF/DKIM/DMARC) ---
# Sans SMTP_HOST, les e-mails sont seulement affichés dans la console (développement).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Adélé Baké <reservation@adelebake.com>"

# --- Référencement (à renseigner à la mise en ligne) ---
# Laisser vide tant que le site n'est pas officiellement lancé : robots.txt bloque alors tout moteur.
ALLOW_INDEXING=""
# Codes « balise HTML » de Google Search Console et Bing Webmaster Tools (contenu de l'attribut content)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
